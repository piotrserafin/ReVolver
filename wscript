import json
import os
import os.path

top = '.'
out = 'build'

# Build environment: `REVOLVER_ENV=dev pebble build` → dev, plain `pebble build` → prod.
# Selected at build time so a release .pbw can never point at the dev backend.
AUTH_PAGE_URL = 'https://piotrserafin.github.io/ReVolverAuth/'
ENVIRONMENTS = {
    'prod': {
        'LAMBDA_URL': 'https://tpl5qhrn75bxzps77pdqllhxuy0mckgw.lambda-url.eu-central-1.on.aws/',
        'AUTH_URL': AUTH_PAGE_URL,
    },
    'dev': {
        'LAMBDA_URL': 'https://ckcflhkgzt3p6lsxad5uvxom740fkwbr.lambda-url.eu-central-1.on.aws/',
        'AUTH_URL': 'https://piotrserafin.github.io/ReVolverAuth-dev/',
    },
}


def revolver_env():
    env = os.environ.get('REVOLVER_ENV', 'prod')
    if env not in ENVIRONMENTS:
        raise ValueError("REVOLVER_ENV must be one of {}, got '{}'".format(sorted(ENVIRONMENTS), env))
    return env


def write_env_js(ctx, env):
    """Generate src/pkjs/env.js (gitignored). Rewritten only when the content changes."""
    values = dict(ENVIRONMENTS[env], ENV=env)
    content = ('// Generated by wscript from REVOLVER_ENV. Do not edit, do not commit.\n'
               'module.exports = {};\n').format(json.dumps(values, indent=2, sort_keys=True))
    node = ctx.path.make_node('src/pkjs/env.js')
    if not os.path.exists(node.abspath()) or node.read() != content:
        node.write(content)


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    """
    This method is used to configure your build. ctx.load(`pebble_sdk`) automatically configures
    a build for each valid platform in `targetPlatforms`. Platform-specific configuration: add your
    change after calling ctx.load('pebble_sdk') and make sure to set the correct environment first.
    Universal configuration: add your change prior to calling ctx.load('pebble_sdk').
    """
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')

    env = revolver_env()
    write_env_js(ctx, env)
    print('ReVolver environment: {}'.format(env))

    build_worker = os.path.exists('worker_src')
    binaries = []

    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        if env == 'dev':
            ctx.env.append_value('DEFINES', 'REVOLVER_DEV')
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'), target=app_elf, bin_type='app')

        if build_worker:
            worker_elf = '{}/pebble-worker.elf'.format(ctx.env.BUILD_DIR)
            binaries.append({'platform': platform, 'app_elf': app_elf, 'worker_elf': worker_elf})
            ctx.pbl_build(source=ctx.path.ant_glob('worker_src/c/**/*.c'),
                          target=worker_elf,
                          bin_type='worker')
        else:
            binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js',
                                         'src/pkjs/**/*.json',
                                         'src/common/**/*.js']),
                   js_entry_file='src/pkjs/index.js')
