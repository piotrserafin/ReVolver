{
  "name": "ReVolver",
  "author": "Piotr Serafin",
  "version": "1.3.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "ReVolver",
    "uuid": "6c51f45b-480d-4c4f-bd67-99c6980179f4",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "volvocars.com",
            "piotrserafin.github.io",
            "piotrserafin.dev",
            "tpl5qhrn75bxzps77pdqllhxuy0mckgw.lambda-url.eu-central-1.on.aws",
            "ckcflhkgzt3p6lsxad5uvxom740fkwbr.lambda-url.eu-central-1.on.aws"
          ]
        },
        "reason": "Log in with Volvo ID and control your car through the Volvo API",
        "required": true
      },
      {
        "name": "Location",
        "reason": "Show the way to your parked car",
        "required": false
      }
    ],
    "messageKeys": [
      "VIN",
      "STATUS_MSG",
      "COMMAND",
      "COMMAND_RESULT",
      "VIBRATE",
      "CAR_STATUS",
      "CAR_INFO",
      "AVAILABLE_CMDS",
      "QUICK_ACTION",
      "QUICK_EXIT",
      "FIND_CAR"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "APP_ICON",
          "file": "images/icon.png",
          "menuIcon": true
        }
      ]
    }
  }
}
